{
  "description": "Familiar's documentation images (README, CONCEPT, MVP, RESEARCH, ARCHITECTURE, docs/RELEASING). Run tools/capture-docs.sh, which builds the game, serves the web build and runs darkroom on this file.",
  "out": "../../docs/images",
  "vars": {
    "base": "http://127.0.0.1:8846/",
    "native": "../../build-docs-native/familiar",
    "witchcraft": ""
  },
  "devices": {
    "phone2": {
      "width": 390,
      "height": 844,
      "dpr": 2,
      "touch": true,
      "mobile": true
    },
    "phone2-landscape": {
      "width": 844,
      "height": 390,
      "dpr": 2,
      "touch": true,
      "mobile": true
    }
  },
  "budgets": {
    "still_kb": 200,
    "gif_mb": 3
  },
  "defaults": {
    "backend": "web",
    "device": "desktop",
    "url": "{base}",
    "waitUntil": "commit",
    "ready": "window.__docs && __docs.ready()",
    "readyTimeout": 300000,
    "screenshotTimeout": 300000,
    "timeout": 1500,
    "initScript": {
      "file": "page-helpers.js"
    },
    "userAgent": "familiar-docs headless",
    "css": "#clickToPlay { display: none !important; }",
    "quality": 84
  },
  "shots": [
    {
      "name": "tour",
      "kind": "still",
      "backend": "command",
      "argv": [
        "{native}",
        "--headless",
        "--tour",
        "--frames",
        "{out_dir}",
        "--width",
        "960",
        "--height",
        "540"
      ],
      "env": {
        "LIBGL_ALWAYS_SOFTWARE": "1",
        "GALLIUM_DRIVER": "llvmpipe"
      },
      "device": {
        "width": 960,
        "height": 540
      },
      "outputs": {
        "nanas-porch": {
          "file": "01-nanas-porch.png",
          "caption": "5:20 pm on Nana's walk: choose a costume.",
          "alt": "Dusk on Nana's front walk, the street and the Garcias' house beyond a picket fence, the HUD on the left"
        },
        "window-lantern": {
          "file": "02-nanas-window-lantern.png",
          "caption": "The first lantern, in Nana's window, for her mother Ada.",
          "alt": "A lit lantern jar glowing in Nana's window at dusk"
        },
        "desktop-street": {
          "file": "06-dusk-street.png",
          "caption": "Elm Street after sunset, porch lights on: the desktop build.",
          "alt": "Elm Street at nightfall with porch lights and streetlamps, the HUD on the left"
        },
        "cat-fence": {
          "file": "07-cat-over-fence.png",
          "caption": "As the cat, up on a picket fence.",
          "alt": "A cat's-eye view along the top of a white picket fence at night"
        },
        "cat-spirits": {
          "file": "12-cat-churchyard-spirits.png",
          "caption": "In the churchyard the cat sees a spirit out walking.",
          "alt": "A faint, pale glowing figure among the churchyard stones at night"
        },
        "smoke-oak": {
          "file": "19-smoke-under-the-oak.png",
          "caption": "Smoke, Nana's old cat, found under the oak.",
          "alt": "A small grey glowing cat sitting in the dark grass"
        },
        "offering": {
          "file": "20-the-offering.png",
          "caption": "The offering at the stones on Lantern Hill.",
          "alt": "Night at the stone circle; Nana's words about the offering in the message line"
        },
        "midnight": {
          "file": "21-midnight-smoke-goes-home.png",
          "caption": "Midnight: Smoke walks out between the stones.",
          "alt": "At midnight a small grey cat walks away into the dark between the stones"
        }
      }
    },
